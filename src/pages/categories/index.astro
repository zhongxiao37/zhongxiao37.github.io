---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { postCategories } from '../../utils/postPath.js';

const allPosts = await getCollection('blog');

const tagCount = {};
allPosts.forEach(post => {
  if (!post.data.date || !post.data.title) return;
  postCategories(post.data).forEach(cat => {
    tagCount[cat] = (tagCount[cat] ?? 0) + 1;
  });
});

const tags = Object.entries(tagCount).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Categories">
  <h1>Categories</h1>
  <ul class="list-none p-0 flex flex-wrap gap-2">
    {tags.map(([tag, count]) => (
      <li>
        <a href={`/categories/${tag}/`} class="inline-block px-2 py-1 bg-gray-100 rounded text-sm no-underline hover:bg-blue-100 hover:text-blue-600">
          {tag} <span class="text-gray-400">({count})</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
